{
  "name": "alshowuhow",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "start-server-and-test dev http://localhost:3000 \"cypress run --e2e\"",
    "test:e2e:open": "start-server-and-test dev http://localhost:3000 \"cypress open --e2e\"",
    "test:component": "cypress run --component",
    "test:component:open": "cypress open --component",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:schema-sql": "npx tsx scripts/generate-schema-sql.ts",
    "db:schema-sql:check": "npx tsx scripts/generate-schema-sql.ts --check",
    "db:reset": "npx tsx scripts/assert-local-db.ts && npx prisma migrate reset --force && npm run db:seed",
    "db:studio": "npx prisma studio",
    "db:push-turso": "npm run db:schema-sql && npx tsx scripts/push-to-turso.ts",
    "admin:add": "npx tsx scripts/add-admin.ts",
    "vendor:purge-demo": "npx tsx scripts/purge-demo-vendors.ts",
    "email:test": "npx tsx scripts/test-email.ts",
    "db:check-drift": "npx tsx scripts/check-schema-drift.ts",
    "db:diagnose-turso": "npx tsx scripts/diagnose-turso.ts",
    "db:inspect": "npx tsx scripts/inspect-db.ts",
    "db:migrate-prod": "npx tsx scripts/migrate-prod-other-service.ts",
    "db:migrate-prod-tree": "npx tsx scripts/migrate-prod-service-tree.ts",
    "db:seed-prod-tree": "npx tsx scripts/seed-prod-service-tree.ts",
    "db:check-drift:required": "npx tsx scripts/check-schema-drift.ts --required"
  },
  "allowedScripts": {
    "@prisma/engines": true,
    "prisma": true,
    "esbuild": true
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-libsql": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "next": "16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.22.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cypress": "^15.21.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
