# Environment variables. Copy to .env for local development:
#
#   cp .env.example .env
#
# Every value here is a placeholder. Never commit a real .env - it is gitignored.
# On Vercel these are set in Project > Settings > Environment Variables instead,
# scoped per environment. See README.md for the full deploy runbook.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------

# Local development: a SQLite file in the project root, gitignored.
# Set this to `file:./dev.db` and leave DATABASE_AUTH_TOKEN empty.
DATABASE_URL="file:./dev.db"
DATABASE_AUTH_TOKEN=""

# Production (Vercel): MUST be a Turso libSQL URL, never `file:`.
# Get both values from the Turso dashboard, or:
#   turso db tokens create --database <db-name>
#
#   DATABASE_URL="libsql://<db-name>.turso.io"
#   DATABASE_AUTH_TOKEN="<turso-auth-token>"
#
# On Vercel the filesystem is ephemeral, so a `file:` URL would deploy successfully
# and then serve an EMPTY database. src/lib/db-url.ts throws on that combination
# during the build rather than letting it through.
#
# NOTE: this must be set for the PREVIEW environment too. Vercel sets VERCEL=1 on
# preview builds as well, so a preview without DATABASE_URL fails to build. Point it
# at a scratch database or a Turso branch - not at production.

# ---------------------------------------------------------------------------
# Auth (required)
# ---------------------------------------------------------------------------

# NextAuth v5 JWT signing secret. Generate with: openssl rand -base64 32
# Use a DIFFERENT value for Preview than for Production, so a preview session
# cannot be forged into production.
AUTH_SECRET=""

# Required in production. The admin console runs on admin.alshowuhow.com, a
# different host from alshowuhow.com. Cookies are host-only by default, so without
# an explicit domain the admin console is never authenticated and sign-out appears
# flaky. Leading dot is required.
#
# Leave unset locally: .localhost is on the public suffix list, so subdomain
# cookies do not work on localhost.
# AUTH_COOKIE_DOMAIN=".alshowuhow.com"

# Only used to build links inside transactional emails (the "Sign in" link in the
# customer confirmation, the admin dashboard link in alerts).
# Local: http://localhost:3000
# Production: https://alshowuhow.com
# Preview: any valid origin, e.g. https://alshowuhow-git-<branch>-<user>.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# NOTE: AUTH_TRUST_HOST is intentionally absent. No code reads it -
# src/lib/auth.ts hardcodes `trustHost: true`. Setting it has no effect.

# ---------------------------------------------------------------------------
# Email - Resend (required in production)
# ---------------------------------------------------------------------------

# Send-only API key from https://resend.com/api-keys
# Leave empty locally to run in dry-run mode: email is logged instead of sent.
RESEND_API_KEY=""

# The From header. EMAIL_FROM's domain must be verified in Resend or mail is
# dropped. Unset, it falls back to Resend's onboarding@resend.dev sandbox, which
# only reaches your own account address.
EMAIL_FROM="ALshowUhow <no-reply@alshowuhow.com>"

# Where admin notifications (new customer requests, new vendor applications) go.
# Unset, it falls back to a hardcoded address - set it explicitly.
ADMIN_NOTIFY_EMAIL=""

# Optional extra CC recipient(s) on admin notifications. Comma-separated.
# ADMIN_NOTIFY_CC=""

# ---------------------------------------------------------------------------
# Seed-only. NEVER set these in production.
# ---------------------------------------------------------------------------

# npm run db:seed / db:reset / admin:add only. The seed script DELETES every row
# before inserting demo data and refuses to run against a remote database without
# an explicit --allow-prod flag. Both passwords are required by the scripts and
# hard-fail rather than defaulting to something guessable.
SEED_ADMIN_PASSWORD=""
# Appends to the two built-in admin addresses.
SEED_ADMIN_EMAIL=""
# Replaces the admin list outright. Takes precedence over SEED_ADMIN_EMAIL.
SEED_ADMIN_EMAILS=""
SEED_VENDOR_PASSWORD=""
# Set to 1 to create the demo vendor rows. Equivalent to --with-vendor-demo.
SEED_VENDOR_DEMO=""

# Passwords that identify demo vendors for `npm run vendor:purge-demo`.
# Defaults to "vendor123" if unset, which is wrong once real vendors exist.
# DEMO_PASSWORDS="vendor123,demo1234"

# ---------------------------------------------------------------------------
# Local scripts against production. Never set these on Vercel.
# ---------------------------------------------------------------------------

# The prod migration, drift-check, add-admin and purge scripts read these instead
# of DATABASE_URL, so a script run can never be aimed at production by accident
# with the app's own variable. Supply them per-invocation:
#
#   TURSO_DATABASE_URL="libsql://..." TURSO_AUTH_TOKEN="..." npm run db:check-drift
#
# The daily .github/workflows/schema-drift.yml job supplies these from repository
# secrets (Settings > Secrets and variables > Actions).





